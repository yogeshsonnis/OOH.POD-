<UserControl x:Class="OOH.POD.Pages.DropOffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOH.POD.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="I am a..." FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,60" Foreground="DeepSkyBlue"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >

              
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding PickUpCommand}" Margin="50">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Images/customer.png" Width="150" Height="150" Stretch="Uniform"/>
                    <TextBlock Text="Customer" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </Button>

           
            <Button Command="{Binding DeliveryDriverCommand}"  Style="{StaticResource IconButtonStyle}" Margin="50">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Images/customerdrivers.png" Width="150" Height="150" Stretch="Uniform"/>
                    <TextBlock Text="Delivery Driver" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </Button>

        </StackPanel>
        </StackPanel>

        
    </Grid>
</UserControl>
