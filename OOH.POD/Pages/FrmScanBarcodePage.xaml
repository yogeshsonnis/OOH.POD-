<UserControl x:Class="OOH.POD.Pages.FrmScanBarcodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOH.POD.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A3D8FF" Offset="0"/>

                <GradientStop Color="#F7FCFF" Offset="1"/>

            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Please Scan your barcode below" FontSize="33" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="/Images/CodeScanner.png" Grid.Row="1"  Stretch="Uniform" Height="350" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="or" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Button Grid.Row="1" Style="{StaticResource ManuallButton}" HorizontalAlignment="Right"  FontSize="20" FontWeight="Regular" Command="{Binding NavigateToFrmEnterBarcodeCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Enter manually" FontSize="25" FontWeight="Medium" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <Path Data="M10.22,9.28a.75.75,0,0,1,0-1.06l2.72-2.72H.75A.75.75,0,0,1,.75,4H12.938L10.22,1.281A.75.75,0,1,1,11.281.22l4,4a.749.749,0,0,1,0,1.06l-4,4a.75.75,0,0,1-1.061,0Z"
Fill="Black"
Height="20" 
Stretch="UniformToFill"
/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
