<UserControl x:Class="OOH.POD.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOH.POD.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" >
        <TextBlock Text="Welcome to OOH POD" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"  Foreground="DeepSkyBlue" Margin="0,0,0,60"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" >

            
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding PickUpCommand}" Margin="50" >
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Images/deliverylocations.png" Height="170" Width="170" Stretch="Uniform"/>
                    <TextBlock Text="Pick Up" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0"/>
                </StackPanel>
            </Button>

            
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DropOffCommand}" Margin="50">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Images/dropoff.png" Width="170" Height="170" Stretch="Uniform" />
                    <TextBlock Text="Drop Off" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0"/>
                </StackPanel>
            </Button>

        </StackPanel>
            </StackPanel>
        </Grid>
    
</UserControl>
