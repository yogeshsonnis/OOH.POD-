<UserControl x:Class="OOH.POD.Pages.GridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOH.POD.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
   
    <Grid  Margin="20,20,20,20">
        <Grid>
            <StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                    <Button Content="Load" Style="{StaticResource BlueButtonStyle}" Command="{Binding LoadCommand}" Width="80"/>
                    <Button Content="Save" Style="{StaticResource BlueButtonStyle}" Command="{Binding SaveCommand}" Width="80" Margin="10,0,0,0"/>
                    <Button Content="Add Compartment" Style="{StaticResource BlueButtonStyle}" Command="{Binding AddCompartmentCommand}" Width="140" Margin="10,0,0,0" />
                    <Button Content="Next  Page" Style="{StaticResource BlueButtonStyle}" Command="{Binding NextPageCommand}"  Width="140" Margin="300,0,0,0" />
                </StackPanel>

                <!-- Compartments Grid -->
                <DataGrid ItemsSource="{Binding Compartments}"
                      AutoGenerateColumns="False"
                          CanUserAddRows="False" 
                      SelectedItem="{Binding SelectedCompartment, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="300" Header="Name" Binding="{Binding CompartmentName}"/>
                        <DataGridTextColumn Width="100" Header="Size" Binding="{Binding CompartmentSize}" />
                        <DataGridCheckBoxColumn Width="100" Header="Closed" Binding="{Binding IsClosed}" />
                        <DataGridCheckBoxColumn Width="100" Header="Locked" Binding="{Binding IsLocked}" />
                        <DataGridCheckBoxColumn Width="100" Header="OOS" Binding="{Binding IsOutOfService}" />

                        <!-- Button to add shipment -->
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Add Shipment" Style="{StaticResource BlueButtonStyle}" Width="150"
                                        Command="{Binding DataContext.AddShipmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Shipments nested grid -->
                <TextBlock Text="Shipments:" Margin="0,20,0,5"/>
                <DataGrid ItemsSource="{Binding SelectedCompartment.Shipments}"
                          HorizontalContentAlignment="Center"
                          CanUserAddRows="False"
                      AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="Tracking" Binding="{Binding TrackingNumber}" />
                        <DataGridTextColumn Width="*" Header="Stored" Binding="{Binding TimeStored}" />
                        <DataGridTextColumn Width="*" Header="Overdue" Binding="{Binding TimeOverdue}" />
                        <DataGridTextColumn Width="*" Header="Stayed" Binding="{Binding TimeStayed}" />
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </Grid>

       
    </Grid>
</UserControl>
