<UserControl x:Class="OOH.POD.Pages.RecipientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOH.POD.Pages"
             mc:Ignorable="d" 
             >
    <Grid >
        <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
</Grid.RowDefinitions>
<TextBlock Text="Enter recipient's OOH ID" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="36" FontWeight="Medium" Foreground="DeepSkyBlue" Margin="0,20,0,20"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
    <TextBlock Text="OOH" VerticalAlignment="Center" FontSize="36" FontWeight="Bold" Margin="0,0,10,0"/>
    <StackPanel Orientation="Horizontal" Grid.Row="1">

                <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
                <TextBox Style="{StaticResource RoundedTextBoxStyle}"/>
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
        <TextBlock Text="-" 
       FontSize="36" 
       VerticalAlignment="Center" 
       Margin="0,0,0,0" 
       Foreground="#FF808080"/>
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />
        <TextBox Style="{StaticResource RoundedTextBoxStyle}" />

    </StackPanel>
</StackPanel>
<Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Style="{StaticResource InfoCardBorderStyle}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="40">
        <StackPanel HorizontalAlignment="Center" >

            <TextBlock Text="Check address label"
           FontSize="23"
           Foreground="#555"
           HorizontalAlignment="Center" Margin="0,0,0,0"/>

            <TextBlock Text="OOH **** ****"
           FontSize="17"
           FontWeight="Bold"
           Foreground="#1E88E5"
           
           HorizontalAlignment="Center"/>

            <Image Source="/Images/Box.png"
       
         Height="170"
       Stretch="Uniform"/>

        </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,20,0,0">
    <UniformGrid Rows="4" Columns="3"  >

                    <Button Style="{StaticResource KeypadButtonStyle}" Content="1" />
        <Button Style="{StaticResource KeypadButtonStyle}" Content="2"/>
        <Button Style="{StaticResource KeypadButtonStyle}" Content="3"/>

        <Button Style="{StaticResource KeypadButtonStyle}" Content="4"/>
        <Button Style="{StaticResource KeypadButtonStyle}" Content="5"/>
        <Button Style="{StaticResource KeypadButtonStyle}" Content="6"/>

        <Button Style="{StaticResource KeypadButtonStyle}" Content="7"/>
        <Button Style="{StaticResource KeypadButtonStyle}" Content="8"/>
        <Button Style="{StaticResource KeypadButtonStyle}" Content="9"/>
        <!--<Button Background="White" BorderThickness="0" />-->


                    <Button Style="{StaticResource KeypadButtonStyle}" Content="0" />
        <Button Style="{StaticResource DeleteButtonStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⌫" FontSize="28"/>
            </StackPanel>
        </Button>

    </UniformGrid>
                <Button Style="{StaticResource RoundedButton}" Content="Confirm" Command="{Binding NavigateToFrmScanBarcodeCommand}"/>
    </StackPanel>
</Grid>
    </Grid>
</UserControl>
