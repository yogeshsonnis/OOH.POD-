<Window x:Class="OOH.POD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOH.POD"
        xmlns:converters="clr-namespace:OOH.POD.Converters"
       
        WindowState="Maximized"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
            xmlns:vm="clr-namespace:OOH.POD.ViewModels"
    xmlns:screens="clr-namespace:OOH.POD.Pages">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <screens:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeliveryDriverViewModel}">
            <screens:DeliveryDriverPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DropOffViewModel}">
            <screens:DropOffPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipientsPageViewModel}">
            <screens:RecipientsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrmScanBarcodePageViewModel}">
            <screens:FrmScanBarcodePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrmEnterBarcodePageViewModel}">
            <screens:FrmEnterBarcode/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GridPageViewModel}">
            <screens:GridPage/>
        </DataTemplate>



    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
           
            <RowDefinition Height="180"/>
           
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CFE5FA" Offset="0"/>
                    
                    <GradientStop Color="#90C2E8" Offset="0.5"/>
                    
                    <GradientStop Color="#69A9DB" Offset="1"/>
                    
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Button Visibility="{Binding IsOnDropOffScreen, Converter={StaticResource BoolToVisibilityConverter}}"
     
                    HorizontalAlignment="Left" Command="{Binding NavigateBackCommand}" x:Name="BackButton"  Style="{StaticResource Buttonbackstyle}" Width="80" Margin="40,0,0,0" />
                
                
                <Border Width="100" Height="100" Background="LightGray" CornerRadius="50">
                    <Image Source="/Images/oohpod.png" Stretch="Uniform" />
                </Border>

            </Grid>
        </Border>

       
        <ContentControl Content="{Binding CurrentScreen}" Grid.Row="1"/>

    </Grid>

</Window>
